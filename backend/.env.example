PULSEOS_ENV=development
PULSEOS_ADMIN_PASSWORD=
PULSEOS_CORS_ORIGINS=
PULSEOS_DATA_DIR=./data
# Supabase Auth JWT verification (server-side)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Supabase publishable key used by the API for user-JWT requests subject to RLS
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
